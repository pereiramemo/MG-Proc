docker.enabled = true

params {
    help           = false
    input_dir      = './tests/data/SRR12479690/'
    // Paired-end glob for channel.fromFilePairs. For single-end runs
    // (--single_end true) the se_reads_pattern below is used instead.
    // reads_pattern    = "*_R{1,2}_001.fastq.gz"
    reads_pattern    = "*_{1,2}.fastq.gz"
    se_reads_pattern = "*.fastq.gz"
    single_end       = false
    output_dir       = './tests/output_nf'
    full_output      = true
    nslots           = 12
    maxForks         = 3
    skip_assembly    = false

    // Tag of the ghcr.io/pereiramemo/mg-proc/* images to pull, applied to every
    // module (see modules/*.nf). Defaults to the moving "latest"; pin to a
    // published version for reproducible runs (--container_tag v1.0.0).
    container_tag  = "latest"

    // MODULE_1_1_QUALITY_CHECK — fastp QC report (report only)
    qc_min_length              = 50
    qualified_quality_phred    = 20
    unqualified_percent_limit  = 40
    disable_adapter_trimming   = 't'

    // MODULE_1_2_QUALITY_CHECK — comparative QC plots. Reuses reads_pattern
    // (PE, with its {1,2} mate token) / se_reads_pattern (SE) to find the
    // staged files; only the subsample size is module-specific.
    qc_sample_size = 10000

    // MODULE_2_PREPROCESS — preprocessing pipeline
    reformat       = 'f'
    repair         = 'f'
    subsample      = 'f'
    trim_adapters  = 'f'
    output_merged  = 't'
    merger         = 'pear'
    min_overlap    = 10
    pvalue         = 0.01
    min_length     = 75
    min_qual       = 20
    seed           = 123
    clean          = 'f'
    compress       = 'f'

    // MODULE_3_ASSEMBLY_AND_MAP — assembly + mapping
    assem_preset      = 'meta-sensitive'
    min_contig_length = 250
    remove_duplicates = 'f'
    contigs           = ''
    assem_dir         = ''
}

// Total CPU budget for the local executor. Nextflow will not start a task whose
// `cpus` request cannot be met from this budget, which lets the aggregate QC
// module run alone with every thread. Keep nslots * maxForks at or below the
// machine's physical core count.
executor {
    cpus = params.nslots * params.maxForks
}

process {
    // Per-sample modules reserve `nslots` CPUs each, so up to `maxForks` run at once.
    cpus     = params.nslots
    maxForks = params.maxForks

    // MODULE_1_2_QUALITY_CHECK processes every sample at once (its input is
    // .collect()ed in mg-proc.nf), so reserve the whole budget: it runs alone
    // with all threads and passes ${task.cpus} to the tool's --nslots.
    withName: MODULE_1_2_QUALITY_CHECK {
        cpus = params.nslots * params.maxForks
    }
}
